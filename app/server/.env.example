# ============================================================================
#  Salin berkas ini menjadi .env lalu isi nilainya.
#  JANGAN pernah commit berkas .env ke git.
# ============================================================================

PORT=4000

# Asal (origin) aplikasi EXOCLEAN yang boleh memanggil server ini.
# Pisahkan dengan koma bila lebih dari satu.
ALLOWED_ORIGINS=http://localhost:8080,https://app.exoclean.id

# URL tujuan setelah pembayaran selesai (opsional)
RETURN_URL=https://app.exoclean.id

# --------------------------------------------------------------- MIDTRANS
# Dashboard Midtrans → Settings → Access Keys
# Pakai kunci Sandbox dulu untuk uji coba.
MIDTRANS_MODE=sandbox
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_MERCHANT_ID=G820929498
MIDTRANS_CLIENT_KEY=SB-Mid-client-enGG0WSWq3bLs21L

# --------------------------------------------------------------- XENDIT
# Dashboard Xendit → Settings → API Keys (buat Secret Key dengan izin Write)
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxxx
# Dashboard Xendit → Settings → Callbacks → Callback Verification Token
XENDIT_CALLBACK_TOKEN=xxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
#  AUTENTIKASI — dipakai auth-server.js  (npm run start:auth)
# ============================================================================

AUTH_PORT=4100

# --------------------------------------------------------------- GOOGLE
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#   Application type : Web application
#   Authorized JavaScript origins : http://localhost:8080  (dan domain produksi)
# Client Secret TIDAK dibutuhkan untuk alur id_token — cukup Client ID.
# Client ID yang sama juga diisi di aplikasi: Pengaturan → Akun & Login.
GOOGLE_CLIENT_ID=1000150545643-7pmcm24js7122ulo6a4ivv0ldj13bl54.apps.googleusercontent.com

# --------------------------------------------------------------- FACEBOOK
# developers.facebook.com → My Apps → Create App → Facebook Login
#   Valid OAuth Redirect URIs : https://app.exoclean.id/
# App Secret HANYA boleh ada di berkas ini, tidak pernah di browser.
FACEBOOK_APP_ID=1481779315926370
FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------- OTP
OTP_TTL_DETIK=300
OTP_JEDA_DETIK=60
OTP_MAKS_SALAH=5
OTP_MAKS_PER_JAM=5

# --------------------------------------------------------------- SMS / WHATSAPP
# log    = kode hanya dicetak ke konsol server (untuk uji coba)
# fonnte = gateway WhatsApp Indonesia — SMS_API_KEY diisi token Fonnte
# twilio = SMS internasional — SMS_API_KEY diisi Auth Token, plus TWILIO_SID
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER=EXOCLEAN
# TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------- EMAIL
# log | resend | sendgrid
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_DARI=EXOCLEAN <no-reply@exoclean.id>

# ------------------------------------------------------------ PENGIRIMAN
# Biteship — tarif kurir, pesanan kirim, dan pelacakan.
#
# API key BERHAK MEMBUAT PESANAN KIRIM, artinya bisa mengeluarkan uang.
# Tempatnya HANYA di berkas ini, tidak pernah di kode browser.
#
# Bentuk kunci yang benar: diawali "biteship_test." atau "biteship_live."
# lalu token JWT panjang (ratusan karakter). Kunci pendek berupa angka-huruf
# saja BUKAN API key Biteship — biasanya itu ID toko atau kode lain yang
# tersalin dari halaman dashboard.
#
# Ambil di: dashboard.biteship.com → Settings → API Keys
KIRIM_PORT=4300
BITESHIP_API_KEY=

# Rahasia webhook: dicocokkan dengan header x-biteship-signature.
# Dikosongkan = webhook diterima tanpa diperiksa — jangan dilakukan di
# produksi, siapa pun yang tahu alamatnya bisa mengaku paket sudah sampai.
BITESHIP_WEBHOOK_SECRET=

# Identitas pengirim yang tercetak pada label paket.
SHIPPER_NAME=EXOCLEAN
SHIPPER_PHONE=081234567001
SHIPPER_EMAIL=ops@exoclean.id
# Pembatas laju kirim-server (per IP): tarif/menit, pesanan kirim/jam, baca/menit.
LAJU_KIRIM_TARIF_PER_MENIT=30
LAJU_KIRIM_ORDER_PER_JAM=20
LAJU_KIRIM_BACA_PER_MENIT=60

# ============================================================================
#  DARMAWISATA INDONESIA H2H — dipakai dwi-server.js  (npm run start:dwi)
# ============================================================================
# MODEL BISNISNYA AGEN PRABAYAR. Setiap transaksi memotong saldo deposit
# perusahaan, dan PASSWORD agen adalah kunci untuk masuk ke saldo itu.
# Tempatnya HANYA di berkas ini — tidak pernah di kode browser, tidak pernah
# di dalam pesan chat, dan tidak pernah ikut ter-commit ke git.
#
# YANG DIKIRIM KE MEREKA BUKAN PASSWORDNYA.
# Sesuai manual H2H, tiap login mengirim:
#     token        = cap waktu  yyyy-MM-dd'T'HH:mm:ss   (mis. 2015-12-21T15:10:20)
#     securityCode = MD5(token + MD5(password))
# Karena securityCode terikat pada satu cap waktu, ia tidak bisa dipakai ulang
# oleh siapa pun yang sempat merekam satu permintaan. Jadi JANGAN menaruh
# securityCode di sini — yang disimpan passwordnya, dan server yang menghitung.


# UAT (uji coba). Pakai host uat-backup: host "uat" yang lama tidak menjawab
# satu port pun dari luar — paketnya dibuang, bukan ditolak.
# PRODUKSI — baru diisi setelah seluruh alur diuji di UAT.
# Server produksi memotong deposit SUNGGUHAN pada setiap transaksi.
# DWI_BASE_URL=https://61.8.74.42:7080/H2H
# ---------------------------------------------------------------- Sesi & brankas data pribadi
# SESI_SECRET: rahasia 256-bit untuk menandatangani sesi (HS256) yang diterbitkan
# auth-server setelah OTP/login sosial dan diverifikasi server lain.
# Buat: node sesi.js --buat-kunci
SESI_SECRET=
SESI_DETIK=43200
# Nomor HP admin yang boleh mendapat sesi 'admin' (dipisah koma, format 08xx atau 62xx)
ADMIN_TELP=
# data-server: brankas data pribadi (AES-256-GCM amplop, DEK per rekaman).
# Buat kunci induk: node brankas.js --buat-kunci  — simpan juga di brankas kata sandi tim.
# Rotasi: pindahkan kunci lama ke BRANKAS_KUNCI_LAMA (format versi:hex, dipisah koma),
# isi BRANKAS_KUNCI baru + naikkan BRANKAS_KUNCI_VERSI, lalu jalankan Putar kunci di konsol admin.
DATA_PORT=4600
BRANKAS_KUNCI=
BRANKAS_KUNCI_VERSI=1
BRANKAS_KUNCI_LAMA=
BRANKAS_DIR=
BRANKAS_TABEL=users,orders,kontakDarurat,toko,penarikanToko,pendaftaran,sosInsiden,foto,vdp
LAJU_DATA_TULIS_PER_MENIT=60
LAJU_DATA_BACA_PER_MENIT=120

# ---------------------------------------------------------------- VDP / bug bounty
# vdp-server menerima laporan kerentanan dari keamanan.html dan menyimpannya
# terenkripsi di brankas (kunci BRANKAS_KUNCI yang sama, tabel vdp).
VDP_PORT=4700
VDP_EMAIL=security@exoclean.id
VDP_SLA_RESPON_HARI=3
LAJU_VDP_PER_JAM=5

# ---------------------------------------------------------------- Customer Care AI
# cs-server menjembatani asisten tanya-jawab ke Claude. Tanpa ANTHROPIC_API_KEY
# (atau tanpa paket @anthropic-ai/sdk) server berjalan dalam mode simulasi:
# aplikasi tetap dijawab mesin kata kunci lokal.
CS_PORT=4500
ANTHROPIC_API_KEY=
CS_MODEL=claude-opus-5
LAJU_CS_PER_MENIT=20

DWI_PORT=4400
DWI_BASE_URL=https://uat-backup.darmawisataindonesiah2h.co.id:7080/H2H
DWI_USER_ID=
DWI_PASSWORD=


# Bahasa balasan API: 1, 2, atau 3 (lihat AuthRequest.language pada swagger).
DWI_LANGUAGE=1

# Cap waktu login memakai waktu LOKAL. Manual tidak menyebut zona waktu dan
# server mereka ada di Indonesia, jadi UTC akan menggeser tujuh jam — pada API
# yang memeriksa kesegaran token itu terbaca sebagai permintaan basi.
# Isi 1 hanya bila mereka ternyata menuntut UTC.
DWI_TOKEN_UTC=0
# Pembatas laju dwi-server per IP: baca/menit, jalur uang per 10 menit.
LAJU_DWI_BACA_PER_MENIT=60
LAJU_DWI_BAYAR_10MENIT=10
# DWI_SIMULASI=1 → balasan tiruan untuk pengembangan tanpa akun (jangan di produksi).

# posisi-server.js — posisi mitra langsung untuk EXOCLEAN App (bawaan 4200)
POSISI_PORT=4200

# ============================================================================
#  KEAMANAN (ditambahkan 4 Sep 2026 — lihat KEAMANAN.md)
# ============================================================================
# 1 bila server berjalan di belakang reverse proxy (nginx/Caddy) supaya alamat
# klien dibaca dari X-Forwarded-For; 0 bila server terpapar langsung.
TRUST_PROXY=0
# Batas nominal satu transaksi (rupiah). Permintaan di atas ini ditolak.
PAY_MAKS_RUPIAH=50000000
# Pembatas laju per alamat IP.
LAJU_UMUM_PER_MENIT=300
LAJU_BAYAR_10MENIT=20
LAJU_STATUS_PER_MENIT=60
LAJU_OTP_KIRIM_PER_JAM_IP=10
LAJU_OTP_PERIKSA_10MENIT_IP=30
LAJU_POSISI_PER_MENIT=60
# Secret key Cloudflare Turnstile. Bila diisi, /api/auth/otp/kirim menolak
# permintaan tanpa token captcha yang sah (pasangan turnstileSiteKey di
# js/exo-config.js).
TURNSTILE_SECRET_KEY=
